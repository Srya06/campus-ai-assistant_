# Environment Configuration Example
# Copy this file to .env and configure your values

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=campus_ai_assistant_secure_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# Database Connection (PostgreSQL or SQLite Fallback)
# For local development with zero setup, leave blank or use sqlite:
DATABASE_URL=sqlite:///./campus_assistant.db
# For PostgreSQL with Docker:
# DATABASE_URL=postgresql+psycopg://campus_user:campus_password@localhost:5432/campus_ai_db

# Google Gemini AI Configuration
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=2
